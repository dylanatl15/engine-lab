#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer A { uvec4 a[]; };
layout(std430, binding = 1) buffer O { uint o[]; };
layout(push_constant) uniform P { uint n; uint iters; } p;   // n uvec4 per WG-slice
void main() {
    uint base = gl_WorkGroupID.x * p.n;
    uint acc = 0;
    for (uint i = gl_LocalInvocationID.x; i < p.n; i += 256) {
        uvec4 v = a[base + i];
        acc += v.x ^ v.y ^ v.z ^ v.w;
    }
    if (acc == 0x12345678u) o[gl_WorkGroupID.x] = acc;
}
