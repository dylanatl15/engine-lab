#version 450
layout(local_size_x=64) in;
layout(binding=0) buffer A { float a[]; };
layout(binding=1) buffer B { float b[]; };
layout(binding=2) buffer C { uint cnt[]; };
layout(push_constant) uniform P { uint n; uint par; uint nph; uint pad; } p;
void main(){
  uint i = gl_GlobalInvocationID.x;
  // read a neighbour from another WG (dependent across WGs)
  uint j = (i + 64u*3u + 5u) % p.n;
  if ((p.par & 1u) == 0u) b[i] = a[j] * 0.5 + 1.0; else a[i] = b[j] * 0.5 + 1.0;
}
