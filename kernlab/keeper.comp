#version 450
layout(local_size_x=64) in;
layout(binding=0) buffer A { uvec4 a[]; };
layout(binding=1) buffer B { uint o[]; };
layout(push_constant) uniform P { uint n; uint iters; uint stride; uint pad; } p;
void main(){
  uint acc = 0u;
  uint i = gl_GlobalInvocationID.x;
  for (uint k = 0; k < p.iters; ++k) {
    uvec4 v = a[(i + k * p.stride) % p.n];
    acc += v.x ^ v.y ^ v.z ^ v.w;
  }
  if (acc == 0x12345u) o[i] = acc;
}
