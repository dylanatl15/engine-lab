+    ggml_set_op_params_i32(result, 0, (int32_t) dst_cell);
+    ggml_set_op_params_i32(result, 1, (int32_t) n_norm);
+    ggml_set_op_params_f32(result, 2, eps);
+
+    result->op     = GGML_OP_GDN_PRE;
+    result->src[0] = qkv;
+    result->src[1] = cache;
+    result->src[2] = conv;
+    result->src[3] = alpha;
+    result->src[4] = beta;
+    result->src[5] = dt;
+    result->src[6] = a;
+    result->src[7] = idx;
