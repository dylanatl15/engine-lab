diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/gated_norm.comp b/ggml/src/ggml-vulkan/vulkan-shaders/gated_norm.comp
new file mode 100644
index 0000000..0ce0a95
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/gated_norm.comp
@@ -0,0 +1,46 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+// rms_norm(x)*w*sigmoid(z) over one row per workgroup (the gated delta net output norm)
+
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer XBuf   { float data_x[];   };
+layout(binding = 1) readonly buffer WBuf   { float data_w[];   };
+layout(binding = 2) readonly buffer ZBuf   { float data_z[];   };
+layout(binding = 3)          buffer DstBuf { float data_dst[]; };
+
+layout(push_constant) uniform Parameters {
+    uint D;
+    float eps;
+    uint o_x, o_w, o_z, o_dst;
+};
+
+shared float red[128];
+
+void main() {
+    const uint t = gl_LocalInvocationID.x;
+    const uint row = gl_WorkGroupID.x;
+    const uint base = row * D;
+
+    float q = 0.0;
+    for (uint d = t; d < D; d += 128u) {
+        const float v = data_x[o_x + base + d];
+        q += v * v;
+    }
+    red[t] = q;
+    barrier();
+    [[unroll]] for (uint s = 64u; s > 0u; s >>= 1u) {
+        if (t < s) {
+            red[t] += red[t + s];
+        }
+        barrier();
+    }
+    const float r = 1.0 / sqrt(red[0] / float(D) + eps);
+
+    for (uint d = t; d < D; d += 128u) {
+        const float zv = data_z[o_z + base + d];
+        data_dst[o_dst + base + d] = (data_x[o_x + base + d] * r * data_w[o_w + d]) * (1.0 / (1.0 + exp(-zv)));
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/gdn_pre.comp b/ggml/src/ggml-vulkan/vulkan-shaders/gdn_pre.comp
new file mode 100644
index 0000000..31ac688
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/gdn_pre.comp
@@ -0,0 +1,88 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+// Everything a gated delta net layer does before the recurrence, for one token of one sequence:
+//   workgroups 0 .. C/128-1: one 128-channel group each: causal conv (4 taps over the 3 cached columns and the
+//   new column) + silu, the shifted conv state written back, and the per-head L2 norm for the first n_norm channels
+//   last workgroup: gate = softplus(alpha + dt)*a and beta = sigmoid(beta_raw)
+// Every channel is read and written by exactly one thread, so the conv state is updated in place.
+
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly  buffer QkvBuf   { float data_qkv[];   };
+layout(binding = 1)           buffer CacheBuf { float data_cache[]; };
+layout(binding = 2) readonly  buffer ConvBuf  { float data_conv[];  };
+layout(binding = 3) readonly  buffer AlphaBuf { float data_alpha[]; };
+layout(binding = 4) readonly  buffer BetaBuf  { float data_beta[];  };
+layout(binding = 5) readonly  buffer DtBuf    { float data_dt[];    };
+layout(binding = 6) readonly  buffer ABuf     { float data_a[];     };
+layout(binding = 7) readonly  buffer IdxBuf   { int   data_idx[];   };
+layout(binding = 8)           buffer DstBuf   { float data_dst[];   };
+
+layout(push_constant) uniform Parameters {
+    uint C;
+    uint n_norm;
+    uint cell_stride;
+    uint dst_cell;
+    uint H;
+    float eps;
+    uint o_qkv, o_cache, o_conv, o_alpha, o_beta, o_dt, o_a, o_idx, o_dst;
+};
+
+shared float red[128];
+
+void main() {
+    const uint t = gl_LocalInvocationID.x;
+    const uint g = gl_WorkGroupID.x;
+
+    if (g * 128u >= C) {
+        // gate and beta
+        if (t < 64u) {
+            float gt = 0.0;
+            float bt = 0.0;
+            if (t < H) {
+                const float al = data_alpha[o_alpha + t] + data_dt[o_dt + t];
+                const float sp = al > 20.0 ? al : log(1.0 + exp(al));
+                gt = sp * data_a[o_a + t];
+                bt = 1.0 / (1.0 + exp(-data_beta[o_beta + t]));
+            }
+            data_dst[o_dst + C + t]       = gt;
+            data_dst[o_dst + C + 64u + t] = bt;
+        }
+        return;
+    }
+
+    const uint c = g * 128u + t;
+    const uint in_base  = o_cache + uint(data_idx[o_idx]) * cell_stride + 3u * c;
+    const uint out_base = o_cache + dst_cell * cell_stride + 3u * c;
+
+    const float s0 = data_cache[in_base + 0u];
+    const float s1 = data_cache[in_base + 1u];
+    const float s2 = data_cache[in_base + 2u];
+    const float x  = data_qkv[o_qkv + c];
+
+    const vec4 w = vec4(data_conv[o_conv + 4u * c], data_conv[o_conv + 4u * c + 1u],
+                        data_conv[o_conv + 4u * c + 2u], data_conv[o_conv + 4u * c + 3u]);
+    float sum = dot(vec4(s0, s1, s2, x), w);
+    sum = sum / (1.0 + exp(-sum));
+
+    // all reads of this thread's three old columns are done above; the other threads own other channels
+    data_cache[out_base + 0u] = s1;
+    data_cache[out_base + 1u] = s2;
+    data_cache[out_base + 2u] = x;
+
+    if (g * 128u < n_norm) {
+        red[t] = sum * sum;
+        barrier();
+        [[unroll]] for (uint s = 64u; s > 0u; s >>= 1u) {
+            if (t < s) {
+                red[t] += red[t + s];
+            }
+            barrier();
+        }
+        sum *= inversesqrt(red[0] + eps);
+    }
+
+    data_dst[o_dst + c] = sum;
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/hc_mix_a.comp b/ggml/src/ggml-vulkan/vulkan-shaders/hc_mix_a.comp
new file mode 100644
index 0000000..b6dfe1c
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/hc_mix_a.comp
@@ -0,0 +1,129 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+// hc_mix, stage A (Flash-Next shape: n_embd 2560, lo 320, hc 4).
+//
+// The hc_mix op computes, for one token, the grouped RMSNorm of the 4 residual streams, the two small
+// bf16 projections around the silu bottleneck, the per-element sigmoid gate and the mean over the streams.
+// Both projections read bf16 weights that are far larger than the activations, so stages are split to
+// stream the weights once and cache the activations:
+//
+// Stage A: workgroup (g, s) owns stream s and `rows_per_wg` (one per subgroup) rows of w_down / w_inject.
+// It stages x*gamma of its stream slice in LDS once and every subgroup dots one weight row slice with it.
+//   P[row][s] = sum_i x[i,s]*gamma[i,s]*w[row, s*n_embd + i]       (rows: lo_dim of w_down, then hc of w_inject)
+//   Q[s]      = sum_i x[i,s]^2
+// Stage B combines these into rstd, lo and inject.
+
+layout(constant_id = 0) const uint SG_SIZE = 64;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter
+{
+    uint n_embd;
+    uint lo_dim;
+    uint x_off;
+    uint g_off;
+    uint wd_off;
+    uint wi_off;
+    uint wu_off;
+    uint o_off;
+    float eps;
+    float inv_hc;
+    uint rows_per_wg;
+};
+
+layout(binding = 0, std430) readonly buffer X  { float data_x[]; };
+layout(binding = 1, std430) readonly buffer G  { float data_g[]; };
+layout(binding = 2, std430) readonly buffer WD { uvec4 data_wd[]; };
+layout(binding = 3, std430) readonly buffer WI { uvec4 data_wi[]; };
+layout(binding = 4, std430) buffer O           { float data_o[]; };
+
+#define N_EMBD 2560
+#define LO     320
+#define HC     4
+#define HALF_N (N_EMBD / 2)
+
+// out layout (floats): mixed[N_EMBD] inject[HC] lo[LO] rstd[HC] Q[HC] P[(LO+HC)*HC]
+const uint O_Q = N_EMBD + HC + LO + HC;
+const uint O_P = O_Q + HC;
+
+shared vec4  xg[N_EMBD / 4];   // x*gamma of this stream, 4 per vec4
+shared float qsh[32];
+
+
+// Weight rows are read as uvec4 (8 bf16): a row slice is N_EMBD/8 = 320 of them, SG_SIZE lanes stride over it.
+#define NV_MAX (N_EMBD / 8 / 32)
+
+void main() {
+    const uint tid  = gl_LocalInvocationID.x;
+    const uint s    = gl_WorkGroupID.y;
+    const uint g    = gl_WorkGroupID.x;
+    const uint lane = gl_SubgroupInvocationID;
+    const uint row  = g * rows_per_wg + gl_SubgroupID;
+
+    // Issue the weight loads first so their latency overlaps the x/gamma staging below.
+    uvec4 wv[NV_MAX];
+    const uint nv = (N_EMBD / 8) / SG_SIZE;
+    if (row < LO + HC) {
+        if (row < LO) {
+            const uint base = (wd_off >> 2) + row * (HC * N_EMBD / 8) + s * (N_EMBD / 8) + lane;
+            [[unroll]] for (uint k = 0; k < NV_MAX; ++k) {
+                if (k < nv) wv[k] = data_wd[base + k * SG_SIZE];
+            }
+        } else {
+            const uint base = (wi_off >> 2) + (row - LO) * (HC * N_EMBD / 8) + s * (N_EMBD / 8) + lane;
+            [[unroll]] for (uint k = 0; k < NV_MAX; ++k) {
+                if (k < nv) wv[k] = data_wi[base + k * SG_SIZE];
+            }
+        }
+    }
+
+    float q = 0.0f;
+    [[unroll]] for (uint k = 0; k < N_EMBD / 256; ++k) {
+        const uint i = tid + k * 256;
+        const float x = data_x[x_off + s * N_EMBD + i];
+        xg[i >> 2][i & 3] = x * data_g[g_off + s * N_EMBD + i];
+        q = fma(x, x, q);
+    }
+    q = subgroupAdd(q);
+    if (subgroupElect()) {
+        qsh[gl_SubgroupID] = q;
+    }
+    barrier();
+
+    if (row < LO + HC) {
+        float p = 0.0f;
+        [[unroll]] for (uint k = 0; k < NV_MAX; ++k) {
+            if (k < nv) {
+                const uint u = lane + k * SG_SIZE;
+                const vec4 a0 = xg[2 * u];
+                const vec4 a1 = xg[2 * u + 1];
+                const uvec4 w = wv[k];
+                p = fma(a0.x, uintBitsToFloat(w.x << 16), p);
+                p = fma(a0.y, uintBitsToFloat(w.x & 0xffff0000u), p);
+                p = fma(a0.z, uintBitsToFloat(w.y << 16), p);
+                p = fma(a0.w, uintBitsToFloat(w.y & 0xffff0000u), p);
+                p = fma(a1.x, uintBitsToFloat(w.z << 16), p);
+                p = fma(a1.y, uintBitsToFloat(w.z & 0xffff0000u), p);
+                p = fma(a1.z, uintBitsToFloat(w.w << 16), p);
+                p = fma(a1.w, uintBitsToFloat(w.w & 0xffff0000u), p);
+            }
+        }
+        p = subgroupAdd(p);
+        if (subgroupElect()) {
+            data_o[o_off + O_P + row * HC + s] = p;
+        }
+    }
+
+    if (g == 0 && tid == 0) {
+        float qs = 0.0f;
+        for (uint i = 0; i < gl_NumSubgroups; ++i) {
+            qs += qsh[i];
+        }
+        data_o[o_off + O_Q + s] = qs;
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/hc_mix_b.comp b/ggml/src/ggml-vulkan/vulkan-shaders/hc_mix_b.comp
new file mode 100644
index 0000000..6365d77
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/hc_mix_b.comp
@@ -0,0 +1,125 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+// hc_mix, stage B (see hc_mix_a.comp). One workgroup per 8 hidden positions.
+// Prologue: finish the A partials into rstd, lo = silu(w_down*xn / hc) and (workgroup 0) inject.
+// Then for each position and stream the gate is dot(w_up row, lo), 8 lanes per row, and
+//   out[i] = inv_hc * sum_s x[i,s]*rstd_s*gamma[i,s] * sigmoid(gate_s)
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter
+{
+    uint n_embd;
+    uint lo_dim;
+    uint x_off;
+    uint g_off;
+    uint wd_off;
+    uint wi_off;
+    uint wu_off;
+    uint o_off;
+    float eps;
+    float inv_hc;
+    uint rows_per_wg;
+};
+
+layout(binding = 0, std430) readonly buffer X  { float data_x[]; };
+layout(binding = 1, std430) readonly buffer G  { float data_g[]; };
+layout(binding = 2, std430) readonly buffer WU { uvec4 data_wu[]; };
+layout(binding = 3, std430) buffer O           { float data_o[]; };
+
+#define N_EMBD 2560
+#define LO     320
+#define HC     4
+#define POS_PER_WG 8
+
+const uint O_INJ  = N_EMBD;
+const uint O_LO   = N_EMBD + HC;
+const uint O_RSTD = O_LO + LO;
+const uint O_Q    = O_RSTD + HC;
+const uint O_P    = O_Q + HC;
+
+shared vec4  lo_s[LO / 4];
+shared float red[256];
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    const uint wg  = gl_WorkGroupID.x;
+
+    const uint slot   = tid >> 3;
+    const uint lane   = tid & 7;
+    const uint stream = slot & 3;
+    const uint pos    = wg * POS_PER_WG + (slot >> 2);
+    const uint rb     = (wu_off >> 2) + (stream * N_EMBD + pos) * (LO / 8);
+
+    // The weight loads do not depend on stage A: issue them before the prologue so their latency overlaps it.
+    uvec4 wv[(LO / 8) / 8];
+    [[unroll]] for (uint k = 0; k < (LO / 8) / 8; ++k) {
+        wv[k] = data_wu[rb + lane + k * 8];
+    }
+
+    float rstd[HC];
+    [[unroll]] for (uint s = 0; s < HC; ++s) {
+        rstd[s] = inversesqrt(data_o[o_off + O_Q + s] / float(N_EMBD) + eps);
+    }
+
+    for (uint j = tid; j < LO; j += 256) {
+        const vec4 p = vec4(data_o[o_off + O_P + j * HC + 0], data_o[o_off + O_P + j * HC + 1],
+                            data_o[o_off + O_P + j * HC + 2], data_o[o_off + O_P + j * HC + 3]);
+        const float v = dot(p, vec4(rstd[0], rstd[1], rstd[2], rstd[3])) * inv_hc;
+        const float l = v / (1.0f + exp(-v));
+        lo_s[j >> 2][j & 3] = l;
+        if (wg == 0) {
+            data_o[o_off + O_LO + j] = l;
+        }
+    }
+    if (wg == 0 && tid < HC) {
+        const uint j = LO + tid;
+        const vec4 p = vec4(data_o[o_off + O_P + j * HC + 0], data_o[o_off + O_P + j * HC + 1],
+                            data_o[o_off + O_P + j * HC + 2], data_o[o_off + O_P + j * HC + 3]);
+        data_o[o_off + O_INJ + tid] = dot(p, vec4(rstd[0], rstd[1], rstd[2], rstd[3]));
+    }
+    if (wg == 0 && tid == 0) {
+        [[unroll]] for (uint s = 0; s < HC; ++s) {
+            data_o[o_off + O_RSTD + s] = rstd[s];
+        }
+    }
+    barrier();
+
+
+    float acc = 0.0f;
+    [[unroll]] for (uint k = 0; k < (LO / 8) / 8; ++k) {
+        const uint u  = lane + k * 8;
+        const uvec4 w = wv[k];
+        const vec4 l0 = lo_s[2 * u];
+        const vec4 l1 = lo_s[2 * u + 1];
+        acc = fma(l0.x, uintBitsToFloat(w.x << 16), acc);
+        acc = fma(l0.y, uintBitsToFloat(w.x & 0xffff0000u), acc);
+        acc = fma(l0.z, uintBitsToFloat(w.y << 16), acc);
+        acc = fma(l0.w, uintBitsToFloat(w.y & 0xffff0000u), acc);
+        acc = fma(l1.x, uintBitsToFloat(w.z << 16), acc);
+        acc = fma(l1.y, uintBitsToFloat(w.z & 0xffff0000u), acc);
+        acc = fma(l1.z, uintBitsToFloat(w.w << 16), acc);
+        acc = fma(l1.w, uintBitsToFloat(w.w & 0xffff0000u), acc);
+    }
+    red[tid] = acc;
+    barrier();
+    [[unroll]] for (uint st = 4; st > 0; st >>= 1) {
+        if (lane < st) {
+            red[tid] += red[tid + st];
+        }
+        barrier();
+    }
+
+    if (lane == 0 && stream == 0) {
+        float r = 0.0f;
+        [[unroll]] for (uint s = 0; s < HC; ++s) {
+            const float gate = red[(tid + 8 * s)];
+            const uint  e    = s * N_EMBD + pos;
+            const float xn   = data_x[x_off + e] * rstd[s] * data_g[g_off + e];
+            r = fma(xn, 1.0f / (1.0f + exp(-gate)), r);
+        }
+        data_o[o_off + pos] = r * inv_hc;
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/lab_mv_iq4_xs.comp b/ggml/src/ggml-vulkan/vulkan-shaders/lab_mv_iq4_xs.comp
new file mode 100644
index 0000000..2fb1f9e
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lab_mv_iq4_xs.comp
@@ -0,0 +1,79 @@
+#version 450
+// Engine-lab: decode-time matvec over repacked IQ4_XS weights (see ggml-vulkan-lab.h).
+// One 16-lane cluster per output row, one lane per 32-value sub-block (16 B load), q8_1 activations.
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_integer_dot_product : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_clustered : require
+
+layout(local_size_x = 64) in;
+
+layout(binding = 0) readonly buffer A  { uvec4 a_qs[]; };
+layout(binding = 0) readonly buffer A2 { uvec2 a_meta[]; };
+layout(binding = 1) readonly buffer B  { uvec4 bq[]; };          // block_q8_1_x4: 9 uvec4 per 128 values
+layout(binding = 2) writeonly buffer D { float dst[]; };
+
+layout(push_constant) uniform P {
+    uint nsb;        // sub-blocks (32 values) per row
+    uint nrows;
+    uint meta_off;   // offset of the header stream in uvec2 units
+    uint dst_off;    // dst element offset
+} pc;
+
+shared uint lut2[256];
+
+const int kv[16] = int[16](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113);
+
+#define BY(v, n) (((v) >> (8 * (n))) & 0xffu)
+#define WD(v, n) (lut2[BY(v, n)] | (lut2[BY(v, (n) + 1)] << 16))
+
+void main() {
+    const uint lid = gl_LocalInvocationID.x;
+    for (uint i = lid; i < 256; i += 64) {
+        lut2[i] = uint(kv[i & 15] & 0xff) | (uint(kv[i >> 4] & 0xff) << 8);
+    }
+    barrier();
+
+    const uint lane = lid & 15;
+    const uint row  = gl_WorkGroupID.x * 4 + (lid >> 4);
+    const uint rowc = min(row, pc.nrows - 1);
+    const uint nblk_row = pc.nsb >> 3;
+
+    float acc = 0.0;
+    [[unroll]] for (uint s = lane; s < pc.nsb; s += 16) {
+        // activations
+        const uint xb = (s >> 2) * 9;
+        const uint xi = s & 3;
+        const uvec4 dsv = bq[xb];
+        const uint dsw = xi == 0 ? dsv.x : (xi == 1 ? dsv.y : (xi == 2 ? dsv.z : dsv.w));
+        const float dx = unpackHalf2x16(dsw).x;
+        const uvec4 xa = bq[xb + 1 + 2 * xi];
+        const uvec4 xc = bq[xb + 2 + 2 * xi];
+
+        // weights
+        const uvec4 w = a_qs[rowc * pc.nsb + s];
+        const uvec2 m = a_meta[pc.meta_off + rowc * nblk_row + (s >> 3)];
+        const uint ib = s & 7;
+        const float d = unpackHalf2x16(m.x & 0xffffu).x;
+        const uint sh = m.x >> 16;
+        const uint ls = ((m.y >> (4 * (ib & 1) + 8 * (ib >> 1))) & 0xfu) | (((sh >> (2 * ib)) & 3u) << 4);
+
+        int dot = 0;
+        dot = dotPacked4x8AccSatEXT(int(WD(w.x, 0)), int(xa.x), dot);
+        dot = dotPacked4x8AccSatEXT(int(WD(w.x, 2)), int(xa.y), dot);
+        dot = dotPacked4x8AccSatEXT(int(WD(w.y, 0)), int(xa.z), dot);
+        dot = dotPacked4x8AccSatEXT(int(WD(w.y, 2)), int(xa.w), dot);
+        dot = dotPacked4x8AccSatEXT(int(WD(w.z, 0)), int(xc.x), dot);
+        dot = dotPacked4x8AccSatEXT(int(WD(w.z, 2)), int(xc.y), dot);
+        dot = dotPacked4x8AccSatEXT(int(WD(w.w, 0)), int(xc.z), dot);
+        dot = dotPacked4x8AccSatEXT(int(WD(w.w, 2)), int(xc.w), dot);
+        acc += d * float(int(ls) - 32) * dx * float(dot);
+    }
+
+    acc = subgroupClusteredAdd(acc, 16);
+    if (lane == 0 && row < pc.nrows) {
+        dst[pc.dst_off + row] = acc;
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/lab_unpack_iq4_xs.comp b/ggml/src/ggml-vulkan/vulkan-shaders/lab_unpack_iq4_xs.comp
new file mode 100644
index 0000000..50dcd6e
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lab_unpack_iq4_xs.comp
@@ -0,0 +1,44 @@
+#version 450
+// Engine-lab: restore the original IQ4_XS block layout from the repacked streams.
+
+#extension GL_EXT_control_flow_attributes : require
+
+layout(local_size_x = 256) in;
+
+layout(binding = 0) readonly buffer A  { uvec4 a_qs[]; };
+layout(binding = 0) readonly buffer A2 { uvec2 a_meta[]; };
+layout(binding = 1) writeonly buffer D { uint dst[]; };
+
+layout(push_constant) uniform P {
+    uint nwords;     // total output words (nblk * 34)
+    uint meta_off;   // uvec2 units
+} pc;
+
+uint get_byte(uvec4 v, uint i) {
+    const uint w = i < 8 ? (i < 4 ? v.x : v.y) : (i < 12 ? v.z : v.w);
+    return (w >> (8 * (i & 3))) & 0xffu;
+}
+
+void main() {
+    const uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * 65535u * 256u;
+    if (gid >= pc.nwords) { return; }
+    const uint blk = gid / 34;
+    const uint wi  = gid % 34;
+    if (wi < 2) {
+        const uvec2 m = a_meta[pc.meta_off + blk];
+        dst[gid] = wi == 0 ? m.x : m.y;
+        return;
+    }
+    const uint q  = wi - 2;          // word within qs (0..31)
+    const uint ib = q >> 2;          // sub-block
+    const uint t  = q & 3;           // word within sub-block
+    const uvec4 n = a_qs[blk * 8 + ib];
+    uint outw = 0;
+    [[unroll]] for (uint b = 0; b < 4; b++) {
+        const uint j = 4 * t + b;
+        const uint lo = (get_byte(n, j >> 1) >> (4 * (j & 1))) & 0xfu;
+        const uint hi = (get_byte(n, 8 + (j >> 1)) >> (4 * (j & 1))) & 0xfu;
+        outw |= (lo | (hi << 4)) << (8 * b);
+    }
+    dst[gid] = outw;
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/moe_combine.comp b/ggml/src/ggml-vulkan/vulkan-shaders/moe_combine.comp
new file mode 100644
index 0000000..31ea115
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/moe_combine.comp
@@ -0,0 +1,37 @@
+#version 450
+
+// The tail of an MoE layer: the weighted routed experts summed in order, plus the shared expert times its
+// sigmoided gate.  dst[e, t] = (((x[e,0,t] + x[e,1,t]) + ...) + x[e,K-1,t]) + shexp[e,t]*sigmoid(gate[t])
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer ExpBuf  { float data_exp[];  };
+layout(binding = 1) readonly buffer ShBuf   { float data_sh[];   };
+layout(binding = 2) readonly buffer GateBuf { float data_gate[]; };
+layout(binding = 3)          buffer DstBuf  { float data_dst[];  };
+
+layout(push_constant) uniform Parameters {
+    uint E;
+    uint K;
+    uint has_sh;
+    uint o_exp, o_sh, o_gate, o_dst;
+};
+
+void main() {
+    const uint e = gl_GlobalInvocationID.x;
+    const uint t = gl_WorkGroupID.y;
+    if (e >= E) {
+        return;
+    }
+
+    const uint base = o_exp + t * E * K + e;
+    float sum = data_exp[base];
+    for (uint k = 1u; k < K; ++k) {
+        sum += data_exp[base + k * E];
+    }
+    if (has_sh != 0u) {
+        const float g = 1.0 / (1.0 + exp(-data_gate[o_gate + t]));
+        sum += data_sh[o_sh + t * E + e] * g;
+    }
+    data_dst[o_dst + t * E + e] = sum;
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/moe_mailbox.comp b/ggml/src/ggml-vulkan/vulkan-shaders/moe_mailbox.comp
