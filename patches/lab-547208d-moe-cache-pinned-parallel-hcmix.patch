+            const std::string name = ggml_get_name(t);
+            float lo_v = -1.0f, hi_v = 1.0f;
+            if (name == "x") { lo_v = -2.0f; hi_v = 2.0f; }
+            if (name == "gamma") { lo_v = 0.5f; hi_v = 1.5f; }
